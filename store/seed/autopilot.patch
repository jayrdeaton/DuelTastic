+// TEMPORARY (App Store screenshots only, never commit): steers the human seats with the CPU's own AI.
+function storeAutopilot(s: GameState, settings: Settings): GameState {
+  if (process.env.EXPO_PUBLIC_STORE_AUTOPILOT !== '1' || s.phase !== 'playing') return s
+  const seats: Player[] = settings.gameMode === 'vsCpu' ? [1] : [1, 2]
+  let next = s
+  for (const seat of seats) {
+    const player = next.players[seat]
+    if (!player.alive) continue
+    const tunnelCellSet = buildTunnelCellSet(next.tunnels)
+    const occupied = buildOccupiedSet(next.players, next.obstacles, tunnelCellSet)
+    const direction = chooseCpuDirection({ player, grid: next.grid, occupied, difficulty: 'normal', ownSteps: stepsFor(player.effects), pickups: next.pickups, heldPowerup: player.heldPowerup, portals: buildPortalLookup(next.portals), tunnelCellSet, tunnelOccupied: buildTunnelOccupiedSet(next.players, tunnelCellSet, seat), wrapEdges: settings.wrapEdges })
+    next = applyTurnIntent(next, seat, direction)
+  }
+  return next
+}
 
