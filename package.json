{
  "name": "dueltastic",
  "version": "1.0.0",
  "private": true,
  "description": "Four arcade duel games in one app: Trap, Turf, Tag and Snake, against the CPU or a friend on one device.",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "eas build",
    "build:web": "npm run verify && WEB_BASE_URL=/dueltastic expo export -p web --output-dir web-build/dueltastic",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "postinstall": "setup-skia-web",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "expo lint .",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc",
    "update": "eas update",
    "verify": "npm run lint && npm test && npm run typecheck"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@reduxjs/toolkit": "^2.14.0",
    "@rific/auto-paper": "^0.15.1",
    "@rific/core": "^0.5.1",
    "@rific/feedback-press": "^0.14.3",
    "@rific/focus-chain": "^0.4.8",
    "@rific/gestures": "^0.1.4",
    "@rific/splash-gate": "^0.2.3",
    "@rific/toaster": "^0.13.1",
    "@rific/updater": "^0.9.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tastic/achievements": "^0.6.1",
    "@tastic/core": "^0.18.0",
    "@tastic/edge-guard": "^0.2.1",
    "@tastic/grid": "^0.1.4",
    "@tastic/hud": "^0.34.0",
    "@tastic/input": "^0.5.1",
    "@tastic/profile": "^0.19.0",
    "@tastic/shell": "^0.11.0",
    "@tastic/split-screen": "^0.6.0",
    "@tastic/sprites": "^0.4.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.7.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
