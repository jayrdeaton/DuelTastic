{
  "expo": {
    "name": "DuelTastic",
    "slug": "DuelTastic",
    "version": "1.0.0",
    "scheme": "dueltastic",
    "description": "Four arcade duel games in one app: LightCycles, Turf, Tag and Snake, against the CPU or a friend on one device.",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/a8aef549-91c1-4c26-bad5-09e8af0b47db"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/icon-dark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.DuelTastic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.infinitetoken.tastic",
          "group.com.infinitetoken.tastic"
        ]
      },
      "requireFullScreen": true
    },
    "android": {
      "package": "com.infinitetoken.dueltastic",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/splash-dark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "@tastic/edge-guard",
      "@tastic/core"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8aef549-91c1-4c26-bad5-09e8af0b47db"
      }
    },
    "owner": "jayrdeaton"
  }
}
