{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run build:web",
  "outputDirectory": "web-build",
  "framework": null,
  "cleanUrls": true,
  "redirects": [{ "source": "/", "destination": "/dueltastic", "permanent": false }],
  "rewrites": [{ "source": "/:game/:path*", "destination": "/:game/index" }]
}
